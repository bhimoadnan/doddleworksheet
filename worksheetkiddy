<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Doodle Worksheet (Copy)</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#e8f6ff;--panel:#fff;--ink:#27304f;--mute:#5b6488;--a:#ff6b6b;--b:#2ec4b6;--c:#7b5ea7;--sun:#ffd23f;--line:#cfe3f2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141a30;--panel:#1f2745;--ink:#f1f3ff;--mute:#a9b2d6;--line:#33406b}}
:root[data-theme="dark"]{--bg:#141a30;--panel:#1f2745;--ink:#f1f3ff;--mute:#a9b2d6;--line:#33406b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:800 17px/1.4 Nunito,system-ui,sans-serif}
h1,h2,.big{font-family:'Baloo 2',Nunito,sans-serif}
.wrap{max-width:1000px;margin:0 auto;padding:16px 14px 48px}
header{text-align:center;margin-bottom:12px}
h1{font-size:clamp(30px,6vw,46px);margin:0;line-height:1.05;font-weight:800}
h1 span{display:inline-block;transform:rotate(-6deg)}
.sub{color:var(--mute);margin:4px 0 0}
.bar{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin:14px 0}
button{font:inherit;color:inherit;cursor:pointer;border:3px solid var(--ink);background:var(--panel);border-radius:16px;padding:8px 18px;box-shadow:0 4px 0 var(--ink);transition:transform .08s,box-shadow .08s}
button:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
button:focus-visible{outline:4px solid var(--c);outline-offset:3px}
button.on{background:var(--sun);color:#27304f}
.tab.on{background:var(--a);color:#fff}
.lvl.on{background:var(--b);color:#fff}
.sect{background:var(--panel);border:3px solid var(--ink);border-radius:24px;padding:16px;margin-bottom:18px}
h2{margin:0 0 10px;font-size:26px;font-weight:800}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:12px}
.card{padding:10px 6px;text-align:center;border-radius:20px;box-shadow:0 5px 0 var(--ink)}
.card .L{font:800 38px/1 'Baloo 2',sans-serif}
.card .e{font-size:44px;line-height:1.15;display:block}
.card .w{font-size:15px}
.card .w b{color:var(--a)}
.c0{background:#fff1f1}.c1{background:#e6faf7}.c2{background:#f1ebfa}.c3{background:#fff8d6}
:root[data-theme="dark"] .card,:root:not([data-theme="light"]) .card{color:#27304f}
.qbox{text-align:center}
.prog{color:var(--mute);margin-bottom:6px}
.pic{font-size:clamp(46px,11vw,76px);line-height:1.2;min-height:90px;word-break:break-all}
.pic button{font-size:inherit;padding:0 12px;border-radius:24px}
.q{font-size:24px;margin:6px 0 12px;font-family:'Baloo 2',sans-serif}
.opts{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.opts button{font:800 36px 'Baloo 2',sans-serif;min-width:88px;padding:6px 20px}
.opts button{max-width:100%;word-break:break-all;line-height:1.2}
.opts button.ok{background:#6ee7a1;color:#0d3b22}
.opts button.no{background:#ffb4b4;color:#5b1111;animation:sh .3s}
@keyframes sh{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.msg{min-height:34px;margin-top:14px;font-size:22px;font-family:'Baloo 2',sans-serif}
.stars{font-size:34px;letter-spacing:4px}
.sl{display:flex;align-items:center;gap:14px;width:100%;text-align:left;margin:8px 0;font-size:21px;line-height:1.5;border-radius:16px;box-shadow:none;border:3px solid transparent;background:transparent;padding:6px 12px}
.sc{flex:0 0 96px;text-align:center;font-size:38px;line-height:1.15}
#sPic{font-size:clamp(64px,18vw,120px);line-height:1.2;padding:8px 0;border-radius:24px;background:var(--bg);min-height:150px;word-break:normal}
.ptxt{font:800 clamp(24px,5.5vw,34px)/1.5 Nunito,sans-serif;text-align:center;margin:14px 6px;min-height:110px}
#sNo{min-width:120px;text-align:center}
button:disabled{opacity:.4;cursor:default}
.lg.on{background:var(--b);color:#fff}
select{font:inherit;padding:8px 10px;border-radius:12px;border:3px solid var(--ink);background:var(--panel);color:var(--ink);max-width:100%}
.pop{animation:pop .5s}
@keyframes pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}
#sList{grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
.sl.now{background:var(--sun);color:#27304f;border-color:var(--ink)}
.tag{font-size:13px;color:#5b6488}
.slide{min-height:min(78vh,700px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;border:3px solid var(--ink);border-radius:28px;padding:16px;color:#27304f;touch-action:pan-y;user-select:none}
.sn{font-size:16px;opacity:.7}
.wpic{font-size:clamp(110px,32vw,230px);line-height:1.05;background:transparent;border:0;box-shadow:none;padding:0}
.wword{font:800 clamp(48px,13vw,110px)/1 'Baloo 2',sans-serif}
.wid{font-size:clamp(20px,4vw,28px);opacity:.8}
.wl{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin:12px 0}
.lt{font:800 clamp(28px,7vw,48px) 'Baloo 2',sans-serif;min-width:clamp(44px,10vw,68px);padding:2px 8px;color:#27304f}
.lt.t0{background:#ffb4b4}.lt.t1{background:#9ee7dc}.lt.t2{background:#cdb8ee}.lt.t3{background:#ffe38a}
.lt.now{background:#fff;transform:scale(1.2);outline:4px solid #7b5ea7}
.sw{width:48px;height:48px;border-radius:50%;padding:0;font-size:22px}
.sw.on{outline:5px solid var(--c);outline-offset:2px;transform:scale(1.15)}
#cpick button{font-size:26px;padding:4px 12px}
#cpick button.on{background:var(--sun)}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{.no-print{display:none!important}body{background:#fff;color:#000}.sect{border-color:#000}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1><span>🌈</span> Doodle Worksheet <span>🚀</span></h1>
  <p class="sub">Phonics, Math and Story Telling for Junior - by Bhimo Adnan</p>
</header>
<div class="bar no-print" id="tabs">
  <button class="tab on" data-m="ph">🔤 Phonics</button>
  <button class="tab" data-m="ma">🔢 Matematika</button>
  <button class="tab" data-m="fn">🎮 Let's Fun</button>
  <button class="tab" data-m="wd">🐾 Words</button>
  <button class="tab" data-m="cl">🎨 Mewarnai</button>
</div>
<div class="bar no-print" id="lvls">
  <button class="lvl on" data-l="tk">🧸 TK</button>
  <button class="lvl" data-l="sd">🎒 Kelas 1</button>
  <button id="print">🖨️ Cetak</button>
</div>
<section class="sect" id="refS"><h2 id="refT"></h2><div class="grid" id="ref"></div></section>
<section class="sect no-print" id="quizS"><h2>Ayo latihan!</h2><div class="qbox" id="quiz"></div></section>
<section class="sect" id="fun" hidden>
  <h2>Let's Fun! 🎮 Maze</h2>
  <div class="bar no-print" id="mz"></div>
  <p class="sub" id="mzT" style="text-align:center"></p>
  <canvas id="cv" width="600" height="420" aria-label="Permainan maze: tarik titik kuning lewat jalan putih" style="width:100%;max-width:640px;display:block;margin:0 auto;border:3px solid var(--ink);border-radius:20px;touch-action:none;cursor:grab"></canvas>
  <div class="msg" id="mzM" role="status" style="text-align:center"></div>
  <div class="bar no-print"><button id="mzR">🔁 Ulangi</button><button id="mzS">🔊 Suara: ON</button><button class="on" id="mzN">Maze berikutnya ➡️</button></div>
</section>
<section class="sect" id="words" hidden>
  <div class="bar no-print" id="wcat"><button class="on" data-c="a">🐾 Hewan / Animals</button><button data-c="o">🧸 Benda / Objects</button></div>
  <div class="slide" id="slide">
    <div class="sn" id="wNo"></div>
    <button class="wpic" id="wPic" aria-label="Dengarkan kata"></button>
    <div class="wword" id="wWord"></div>
    <div class="wid" id="wId"></div>
    <div class="wl" id="wLet"></div>
    <div class="bar no-print"><button class="on" id="wSpell">🔤 Eja</button><button id="wSay">🔊 Dengar</button></div>
  </div>
  <div class="bar no-print"><button id="wPrev">⬅️ Sebelumnya</button><button id="wNext">Berikutnya ➡️</button></div>
</section>
<section class="sect" id="color" hidden>
  <h2>Mewarnai 🎨 Coloring</h2>
  <div class="bar no-print" id="cpick"></div>
  <p class="sub" id="cnm" style="text-align:center"></p>
  <svg id="cs" viewBox="0 0 400 300" role="img" aria-label="Gambar untuk diwarnai" style="width:100%;max-width:640px;display:block;margin:0 auto;border:3px solid var(--ink);border-radius:20px;background:#fff;touch-action:manipulation;cursor:pointer"></svg>
  <div class="bar no-print" id="cpal"></div>
  <div class="msg" id="clM" role="status" style="text-align:center"></div>
  <div class="bar no-print"><button id="clR">🧽 Ulangi</button><button id="clS">🔊 Suara: ON</button><button class="on" id="clN">Gambar berikutnya ➡️</button></div>
</section>
</div>
<script>
const W=[["A","apple","🍎"],["B","bear","🐻"],["C","cat","🐱"],["D","dog","🐶"],["E","egg","🥚"],["F","fish","🐟"],["G","grapes","🍇"],["H","hat","🎩"],["I","ice cream","🍦"],["J","juice","🧃"],["K","key","🔑"],["L","lion","🦁"],["M","moon","🌙"],["N","nut","🥜"],["O","octopus","🐙"],["P","pig","🐷"],["Q","queen","👸"],["R","rabbit","🐰"],["S","sun","☀️"],["T","tiger","🐯"],["U","umbrella","☂️"],["V","van","🚐"],["W","whale","🐳"],["X","fox","🦊"],["Y","yacht","⛵"],["Z","zebra","🦓"]];
const CVC=[["cat","🐱"],["dog","🐶"],["pig","🐷"],["sun","☀️"],["bus","🚌"],["bed","🛏️"],["fox","🦊"],["hen","🐔"],["hat","🎩"],["cup","🥤"]];
const OBJ=["🍎","⭐","🐥","🎈","🍓","🐟","🚗","🌼"];
const hl=(l,w)=>{const k=Math.max(0,w.indexOf(l.toLowerCase()));return w.slice(0,k)+"<b>"+w[k]+"</b>"+w.slice(k+1)};
const R=n=>Math.floor(Math.random()*n), pick=a=>a[R(a.length)];
const shuf=a=>a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(x=>x[1]);
function say(t){try{const u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=.8;speechSynthesis.cancel();speechSynthesis.speak(u)}catch(e){}}
let mode='ph',lvl='tk',Q=null;
const N=()=>mode==='ma'?80:5;
const E=t=>String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
function opts(ans,make){const s=new Set([String(ans)]);let g=0;while(s.size<3&&g++<60)s.add(String(make()));return shuf([...s])}
function gen(){
  if(mode==='ph'&&lvl==='tk'){const p=pick(W.filter(w=>w[0]!=='X'));
    return{pic:`<button data-say="${p[1]}" aria-label="Dengar kata">${p[2]}</button>`,q:'Huruf awal gambar ini apa?',ans:p[0],o:opts(p[0],()=>pick(W)[0]),say:p[1]}}
  if(mode==='ph'){const [w,e]=pick(CVC),i=1,v=w[i];
    return{pic:`<button data-say="${w}" aria-label="Dengar kata">${e}</button><br>${w[0]} _ ${w[2]}`,q:'Huruf apa yang hilang?',ans:v,o:opts(v,()=>pick("aeiou")),say:w}}
  return mathQ();
}
const SH=[["🔴","lingkaran",0],["🟦","persegi",4],["🔺","segitiga",3],["⭐","bintang",0],["❤️","hati",0]];
const CLK=["🕐","🕑","🕒","🕓","🕔","🕕","🕖","🕗","🕘","🕙","🕚","🕛"];
const rp=(n,e)=>e.repeat(n);
let lastT=-1;
const MQ={
 tk:[
  ()=>{const n=1+R(10);return{pic:rp(n,pick(OBJ)),q:'Ada berapa gambar?',ans:n,o:opts(n,()=>1+R(10))}},
  ()=>{const n=1+R(9);return{pic:`${n} , ?`,q:'Angka setelah ini berapa?',ans:n+1,o:opts(n+1,()=>1+R(10))}},
  ()=>{const a=1+R(7),b=a+1+R(3),e=pick(OBJ);let f=pick(OBJ);while(f===e)f=pick(OBJ);const A=rp(a,e),B=rp(b,f);
    return{pic:'🤔',q:'Ketuk kelompok yang lebih banyak',ans:B,o:shuf([A,B])}},
  ()=>{const s0=1+R(7),m=R(4),ans=s0+m;return{pic:[0,1,2,3].map(i=>i===m?'_':s0+i).join(' , '),q:'Angka yang hilang berapa?',ans,o:opts(ans,()=>1+R(10))}},
  ()=>{const n=1+R(8),e=pick(OBJ),o=new Set([n]);while(o.size<3)o.add(1+R(9));return{pic:String(n),q:'Mana gambar yang jumlahnya sama?',ans:rp(n,e),o:shuf([...o].map(k=>rp(k,e)))}},
  ()=>{const a=1+R(5),b=1+R(5);return{pic:`${rp(a,pick(OBJ))} + ${rp(b,pick(OBJ))}<br>${a} + ${b} = ?`,q:'Berapa jumlahnya?',ans:a+b,o:opts(a+b,()=>Math.max(1,a+b+R(5)-2))}},
  ()=>{const a=2+R(8),b=1+R(a-1),e=pick(OBJ);return{pic:rp(a-b,e)+rp(b,'❌'),q:'Gambar yang ❌ diambil. Sisanya berapa?',ans:a-b,o:opts(a-b,()=>1+R(9))}},
  ()=>{const a=1+R(10);let b=1+R(10);while(b===a)b=1+R(10);return{pic:`${a} 🆚 ${b}`,q:'Angka mana yang lebih besar?',ans:Math.max(a,b),o:shuf([a,b])}},
  ()=>{const x=pick(SH),o=new Set([x[1]]);while(o.size<3)o.add(pick(SH)[1]);return{pic:x[0],q:'Bentuk apa ini?',ans:x[1],o:shuf([...o])}},
  ()=>{const [p,q]=shuf(OBJ).slice(0,2),c=2+R(2);return{pic:(p+q).repeat(c)+p+' ?',q:'Gambar apa selanjutnya?',ans:q,o:shuf([p,q,pick(OBJ.filter(x=>x!==p&&x!==q))])}}
 ],
 sd:[
  ()=>{const a=1+R(9),b=1+R(Math.min(10,20-a)),ans=a+b;return{pic:(ans<=10?`${rp(a,pick(OBJ))} + ${rp(b,pick(OBJ))}<br>`:'')+`${a} + ${b} = ?`,q:'Berapa jumlahnya?',ans,o:opts(ans,()=>Math.max(0,ans+R(7)-3))}},
  ()=>{const a=3+R(18),b=1+R(a-1),ans=a-b;return{pic:`${a} − ${b} = ?`,q:'Berapa sisanya?',ans,o:opts(ans,()=>Math.max(0,ans+R(7)-3))}},
  ()=>{const a=1+R(8),t=a+1+R(10-a),b=t-a,e=pick(OBJ);return{pic:`${rp(a,e)} + ❓ = ${rp(t,e)}<br>${a} + ? = ${t}`,q:'Angka berapa yang hilang?',ans:b,o:opts(b,()=>1+R(9))}},
  ()=>{const a=R(21);let b=R(21);if(!R(4))b=a;return{pic:`${a} ? ${b}`,q:'Pilih tanda yang tepat (&lt; kecil, &gt; besar)',ans:a<b?'<':a>b?'>':'=',o:['<','>','=']}},
  ()=>{const st=pick([2,5,10]),s0=st===10?10:st*(1+R(2)),q=[0,1,2,3].map(i=>s0+i*st);return{pic:q.slice(0,3).join(' , ')+' , ?',q:`Lompat ${st}. Angka selanjutnya?`,ans:q[3],o:opts(q[3],()=>Math.max(0,q[3]+pick([-st,st,-1,1,2*st])))}},
  ()=>{const n=2+R(18),af=Math.random()<.5,ans=af?n+1:n-1;return{pic:af?`${n} , ?`:`? , ${n}`,q:af?'Angka setelah ini berapa?':'Angka sebelum ini berapa?',ans,o:opts(ans,()=>Math.max(0,n+R(5)-2))}},
  ()=>{const a=2+R(8),e=pick(['🐥','🍎','🎈','🚗','⭐']),nm=pick(['Ani','Budi','Cici','Dodi']);
    if(R(2)){const b=1+R(Math.min(8,20-a));return{pic:rp(a,e)+' + '+rp(b,e),q:`${nm} punya ${a}. Lalu dapat ${b} lagi. Semuanya berapa?`,ans:a+b,o:opts(a+b,()=>Math.max(0,a+b+R(5)-2))}}
    const b=1+R(a-1);return{pic:rp(a,e)+' − '+rp(b,e),q:`${nm} punya ${a}. ${b} diberikan ke teman. Sisanya berapa?`,ans:a-b,o:opts(a-b,()=>Math.max(0,a-b+R(5)-2))}},
  ()=>{const h=1+R(12);return{pic:CLK[h-1],q:'Jam berapa ini?',ans:h,o:opts(h,()=>1+R(12))}},
  ()=>{const x=pick([SH[1],SH[2]]);return{pic:x[0],q:'Berapa sisi bentuk ini?',ans:x[2],o:shuf([3,4,5])}}
 ]};
function mathQ(){const A=MQ[lvl];let t;do{t=R(A.length)}while(t===lastT&&A.length>1);lastT=t;return A[t]()}
function newRound(){Q={i:0,score:0,tried:false,cur:gen()};drawQ()}
function drawQ(){
  const c=Q.cur;Q.tried=false;
  document.getElementById('quiz').innerHTML=`<div class="prog">Soal ${Q.i+1} dari ${N()} &nbsp; ⭐ ${Q.score}</div><div class="pic">${c.pic}</div><div class="q">${c.q}</div><div class="opts">${c.o.map(x=>`<button data-v="${E(x)}">${E(x)}</button>`).join('')}</div><div class="msg" id="msg" role="status"></div>`;
}
function endRound(){
  const p=Q.score/N(),st=Math.round(p*5);
  document.getElementById('quiz').innerHTML=`<div class="stars">${'⭐'.repeat(st)}${'☆'.repeat(5-st)}</div><div class="big" style="font-size:32px">${p>=.8?'Hebat sekali! 🎉':p>=.4?'Bagus! Terus berlatih 💪':'Ayo coba lagi, kamu pasti bisa! 🌟'}</div><p>Benar pada percobaan pertama: ${Q.score} dari ${N()}</p><button class="on" id="again">Main lagi 🔁</button>`;
}
document.getElementById('quiz').addEventListener('click',e=>{
  const s=e.target.closest('[data-say]');if(s){say(s.dataset.say);return}
  if(e.target.id==='again'){newRound();return}
  const b=e.target.closest('[data-v]');if(!b||b.classList.contains('ok'))return;
  const m=document.getElementById('msg');
  if(b.dataset.v===String(Q.cur.ans)){
    b.classList.add('ok');if(!Q.tried)Q.score++;
    m.textContent=pick(['Benar! 🌟','Pintar! 👏','Keren! 🎈','Yeay! 🥳']);
    document.querySelectorAll('.opts button').forEach(x=>x.disabled=true);
    setTimeout(()=>{Q.i++;if(Q.i>=N())endRound();else{Q.cur=gen();drawQ()}},1100);
  }else{Q.tried=true;b.classList.add('no');b.disabled=true;m.textContent='Coba lagi ya! 💪'}
});
function drawRef(){
  const g=document.getElementById('ref'),t=document.getElementById('refT');
  if(mode==='ph'){t.textContent='Kartu huruf A–Z (ketuk untuk mendengar)';
    g.innerHTML=W.map((w,i)=>`<button class="card c${i%4}" data-say="${w[1]}" aria-label="${w[0]} untuk ${w[1]}"><span class="L">${w[0]}${w[0].toLowerCase()}</span><span class="e">${w[2]}</span><span class="w">${hl(w[0],w[1])}</span></button>`).join('')}
  else{const from=lvl==='tk'?1:11,to=lvl==='tk'?10:20;t.textContent=`Kartu angka ${from}–${to}`;
    let h='';for(let n=from;n<=to;n++)h+=`<div class="card c${n%4}"><span class="L">${n}</span><span class="w">${n<=10?'⭐'.repeat(n):'10 + '+(n-10)}</span></div>`;g.innerHTML=h}
  g.onclick=e=>{const s=e.target.closest('[data-say]');if(s)say(s.dataset.say)}
}
function refresh(){
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.m===mode));
  document.querySelectorAll('.lvl').forEach(b=>b.classList.toggle('on',b.dataset.l===lvl));
  const st=mode==='fn',wd=mode==='wd',cl=mode==='cl',x=st||wd||cl;
  ['refS','quizS'].forEach(i=>document.getElementById(i).hidden=x);
  document.getElementById('fun').hidden=!st;
  document.getElementById('words').hidden=!wd;
  document.getElementById('color').hidden=!cl;
  document.querySelectorAll('.lvl').forEach(b=>b.hidden=x);
  try{speechSynthesis.cancel()}catch(e){}
  if(st){startMaze();return}
  if(wd){startWords();return}
  if(cl){startColor();return}
  drawRef();newRound();
}
document.getElementById('tabs').onclick=e=>{const b=e.target.closest('.tab');if(b){mode=b.dataset.m;refresh()}};
document.getElementById('lvls').onclick=e=>{const b=e.target.closest('.lvl');if(b){lvl=b.dataset.l;refresh()}};
